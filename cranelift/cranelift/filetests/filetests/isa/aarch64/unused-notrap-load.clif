test compile precise-output
target aarch64

function %unused_notrap_load(i64) {
block0(v0: i64):
    v1 = load.i64 notrap v0
    return
}

; VCode:
; block0:
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   ret

function %unused_trapping_load(i64) {
block0(v0: i64):
    v1 = load.i64 v0
    return
}

; VCode:
; block0:
;   ldr x2, [x0]
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   ldr x2, [x0] ; trap: heap_oob
;   ret
