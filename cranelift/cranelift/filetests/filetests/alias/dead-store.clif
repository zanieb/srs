test optimize precise-output
set opt_level=speed
target x86_64

;; A read-only load cannot alias a store, so the later store makes the first one dead.
function %overwrite_across_readonly_load(i64, i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    store notrap v2, v0
    v4 = load.i64 notrap readonly v1
    store notrap v3, v0
    return v4
}

; function %overwrite_across_readonly_load(i64, i64, i64, i64) -> i64 fast {
; block0(v0: i64, v1: i64, v2: i64, v3: i64):
;     v4 = load.i64 notrap readonly v1
;     store notrap v3, v0
;     return v4
; }

;; An ordinary load may observe the first store.
function %load_barrier(i64, i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    store notrap v2, v0
    v4 = load.i64 notrap v1
    store notrap v3, v0
    return v4
}

; function %load_barrier(i64, i64, i64, i64) -> i64 fast {
; block0(v0: i64, v1: i64, v2: i64, v3: i64):
;     store notrap v2, v0
