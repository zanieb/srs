; nextln:    ss0 = explicit_slot 0
; check:  block0(v0: i8, v1: i8, v2: i8, v3: i8, v4: i8, v5: i8, v6: i8, v7: i8):
; nextln:     jump block1
; check:  block1:
; nextln:     v9 = uextend.i64 v0
; nextln:     v37 = iconst.i64 56
; nextln:     v10 = ishl v9, v37  ; v37 = 56
; check:      v29 = uextend.i64 v7
; nextln:     v30 = bor v28, v29
; nextln:     return v30
; nextln: }

function %reinterpreted_stack_load(i8x8) -> i64 {
  ss0 = explicit_slot 8

block0(v0: i8x8):
  stack_store.i8x8 v0, ss0
  v1 = stack_load.i64 ss0
  return v1
}

