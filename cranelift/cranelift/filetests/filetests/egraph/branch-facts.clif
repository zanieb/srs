test optimize
set opt_level=speed_and_size
target x86_64

function %repeat_unsigned_comparison(i64) -> i64 {
block0(v0: i64):
    v1 = iconst.i64 8
    v2 = icmp uge v0, v1
    brif v2, block1, block4

block1:
    v3 = iconst.i64 8
    v4 = icmp uge v0, v3
    brif v4, block2, block3

block2:
    return v0

block3:
    v5 = iconst.i64 3
    return v5

block4:
    v6 = iconst.i64 4
    return v6
}

; check: function %repeat_unsigned_comparison(i64) -> i64 fast {
; check: block1:
; nextln: jump block2
; not: block3

function %complement_unsigned_comparison(i64) -> i64 {
block0(v0: i64):
    v1 = iconst.i64 8
    v2 = icmp uge v0, v1
    brif v2, block1, block4

block1:
    v3 = iconst.i64 8
    v4 = icmp ult v0, v3
    brif v4, block2, block3

block2:
    v5 = iconst.i64 2
    return v5

block3:
    return v0

block4:
    v6 = iconst.i64 4
    return v6
}

; check: function %complement_unsigned_comparison(i64) -> i64 fast {
; check: block1:
; nextln: jump block3
; not: block2

